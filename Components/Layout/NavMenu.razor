@inject Rilevamento_tempi.Services.LavoratoreSelezionatoService LavoratoreSelezionato
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Rilevamento tempi</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="nav flex-column">

        @if (LavoratoreSelezionato.IdLavoratore == null)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/lavoratori">
                    <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Seleziona lavoratore
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Lavori
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/tempi">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Tempi
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        LavoratoreSelezionato.LavoratoreCambiato += OnLavoratoreCambiato;
    }

    private void OnLavoratoreCambiato()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LavoratoreSelezionato.LavoratoreCambiato -= OnLavoratoreCambiato;
    }
}

